{
  "manifest_version": 3,
  "name": "ExportIn",
  "version": "1.1.0",
  "description": "Export birthdays and contact details from LinkedIn, Facebook and Instagram to CSV, for an AI agent to enrich your CRM.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://media.licdn.com/*",
    "https://www.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open ExportIn",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "fb-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "lib.js",
        "content-facebook.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "lib.js",
        "content-instagram.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "homepage_url": "https://github.com/tonoid/ExportIn"
}
